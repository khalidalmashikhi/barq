// =============================================================================
// IDENTITY CONTEXT — DOMAIN_MODEL.md §1
// =============================================================================

/// Base identity record. See implementation note 7 above regarding the
/// unresolved role-exclusivity question.
model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  phoneNumber         String     @unique
  /// Optional display name — the one personal, self-editable identity field
  /// (Finish-Line: Customer Profile). Deliberately kept on the identity `User`
  /// (not duplicated onto Customer/Provider) so every role reuses one name.
  /// Nullable + backward-compatible: existing rows default to NULL and every
  /// read falls back to a masked phone. Reverses the earlier phone-only-minimal
  /// note below, per the approved finish-line directive to give customers a real
  /// editable profile. Still NO email/image/emailVerified — only a display name.
  name                String?
  /// Added by Engineering Sprint (Phone OTP Schema Support) — required by
  /// Better Auth's phone-number plugin. No email, image, or emailVerified field
  /// was added, per explicit instruction.
  phoneNumberVerified Boolean    @default(false)
  status              UserStatus @default(CREATED)
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)

  customer      Customer?
  providerLink  Provider?
  staff         Staff?
  admin         Admin?
  notifications Notification[]

  /// ADR-0009 — link to Better Auth's own infrastructure user record.
  /// Nullable because a BARQ User can exist with no authentication ever
  /// having occurred (Staff-Assisted Booking, per DOMAIN_MODEL.md), and
  /// unique because the relationship is one-to-one. This replaces the
  /// sessions/accounts back-relation arrays previously added here
  /// (Sprint 2) — per ADR-0009, Session/Account now reference AuthUser
  /// directly, not BARQ User, so those back-relations no longer belong
  /// on this model.
  authUserId String?   @unique
  authUser   AuthUser? @relation(fields: [authUserId], references: [id])

  @@map("users")
}

// =============================================================================
// CUSTOMER CONTEXT
// =============================================================================

model Customer {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id])
  preferences        Json?
  languagePreference String? // defaults to platform default (Arabic) if unset, per LOCALIZATION.md §3
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  bookings       Booking[]
  reviews        Review[]
  wallet         Wallet?
  contracts      Contract[]
  supportTickets SupportTicket[]

  @@map("customers")
}

// =============================================================================
// PROVIDER CONTEXT — DOMAIN_MODEL.md §1
// =============================================================================

model Provider {
  id                  String         @id @default(uuid(7)) @db.Uuid
  userId              String         @unique @db.Uuid
  user                User           @relation(fields: [userId], references: [id])
  /// Bilingual — { "ar": "...", "en": "..." } — see implementation note 2 above.
  businessName        Json
  businessDescription Json?
  status              ProviderStatus @default(APPLIED)
  /// INDIVIDUAL vs COMPANY (Gap D). Default COMPANY is the backward-compatible
  /// classification for every pre-existing row (all created with a required
  /// businessName). `businessName` holds the public display name for BOTH types
  /// — a person's professional/personal name for INDIVIDUAL — so no duplicate
  /// name column is added; only the wording around it changes by type.
  providerType        ProviderType   @default(COMPANY)
  /// Set when an Admin approves this provider (see approve-provider.ts) —
  /// the minimum audit trail needed for "Verified Provider" to mean "an
  /// admin looked at this," not "seeded that way."
  approvedAt          DateTime?      @db.Timestamptz(6)
  approvedByAdminId   String?        @db.Uuid
  approvedByAdmin     Admin?         @relation("ProviderApprovedBy", fields: [approvedByAdminId], references: [id])
  /// Phase 2 (Provider Foundation) additions below — deliberately kept
  /// separate from `status`: `status` is the approval/vetting workflow
  /// (unchanged, still enforced by requireApprovedProvider()/BR-001);
  /// `visible` is an independent marketplace-display toggle an admin can
  /// use to hide an already-approved provider without touching its
  /// vetting history (mirrors Category's own status-vs-visibility split,
  /// but as a plain boolean, not a rich state machine, since no named
  /// business rule requires more — same reasoning already applied to
  /// FeatureFlag/HomepageSection in Phase 1).
  slug         String?  @unique
  visible      Boolean  @default(true)
  /// Business-correspondence contact only — never surfaced to a
  /// customer/tourist. Direct phone/WhatsApp/email exposure to tourists
  /// is a permanent policy rule (BR-002 / 10-COMMUNICATION-POLICY.md),
  /// not an oversight to "fix" once a public provider page exists.
  contactEmail String?
  /// "Basic location" per this phase's own scope — free text (e.g. a
  /// city/region name), not geo-coordinates or Maps integration, which
  /// docs/project-memory/05-PROVIDER-EXPERIENCE.md explicitly marks as
  /// later-phase (target) scope, not foundation scope.
  city         String?
  /// Reference only — a URL string. No Attachment/upload model, no file
  /// storage: media uploads are explicitly out of this phase's scope.
  logoUrl      String?
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  drivers        Driver[]
  guides         Guide[]
  assets         Asset[]
  services       Service[]
  commissions    Commission[]
  wallet         Wallet?
  contracts      Contract[]
  bookings       Booking[]       @relation("BookingProvider")
  reviews        Review[]        @relation("ReviewProvider")
  supportTickets SupportTicket[]
  categoryLinks  ProviderCategory[]
  mediaAssets    MediaAsset[]

  @@index([status])
  @@index([approvedByAdminId])
  @@index([visible])
  @@map("providers")
}

model Driver {
  id          String       @id @default(uuid(7)) @db.Uuid
  providerId  String       @db.Uuid
  provider    Provider     @relation(fields: [providerId], references: [id])
  /// Bilingual, Partial per DATABASE_DESIGN.md §5.
  displayName Json
  status      DriverStatus @default(REGISTERED)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  bookings Booking[]

  @@index([providerId])
  @@index([status])
  @@map("drivers")
}

model Guide {
  id          String      @id @default(uuid(7)) @db.Uuid
  providerId  String      @db.Uuid
  provider    Provider    @relation(fields: [providerId], references: [id])
  displayName Json
  status      GuideStatus @default(REGISTERED)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  bookings Booking[]

  @@index([providerId])
  @@index([status])
  @@map("guides")
}

/// Generic registrable resource. Specialized by Vehicle via Class Table
/// Inheritance (shared primary key) — PRISMA_SCHEMA.md §4's resolution of
/// DATABASE_DESIGN.md §20 Open Decision #7.
model Asset {
  id         String      @id @default(uuid(7)) @db.Uuid
  providerId String      @db.Uuid
  provider   Provider    @relation(fields: [providerId], references: [id])
  assetType  AssetType
  status     AssetStatus @default(REGISTERED)
  createdAt  DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(6)

  vehicle Vehicle?

  @@index([providerId])
  @@index([status])
  @@index([assetType])
  @@map("assets")
}

/// Specializes Asset via a shared primary key (Class Table Inheritance).
/// Status lives on the base Asset record, not duplicated here.
model Vehicle {
  assetId            String   @id @db.Uuid
  asset              Asset    @relation(fields: [assetId], references: [id])
  registrationNumber String   @unique
  /// Bilingual, Partial per DATABASE_DESIGN.md §5.
  descriptiveDetails Json?
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @db.Timestamptz(6)

  bookings Booking[]

  @@map("vehicles")
}

// =============================================================================
// MARKETPLACE CONTEXT — ADR-0013 (Bounded Context #16, added Phase 1.1)
// =============================================================================

/// BR-004's 6 category visibility states. Deliberately not reused for any
/// other entity's status — a distinct concept from ServiceStatus/ProviderStatus
/// despite the shared "lifecycle enum" shape, per DATABASE_DESIGN.md §5's
/// convention of one enum per concept rather than a shared generic status.
enum CategoryVisibilityStatus {
  PUBLIC
  HIDDEN
  LINK_ONLY
  INVITE_ONLY
  SCHEDULED
  ARCHIVED
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Bilingual — { "ar": "...", "en": "..." } — see implementation note 2 above.
  name      Json
  slug      String   @unique
  /// Self-referential tree — ADR-0015 (Taxonomy v2), P1. A "sub-category" is
  /// a depth-1 child (parentId set), not a separate table. Max depth is 2
  /// (hard cap 3), enforced by the MAX_CATEGORY_DEPTH code constant, NOT a
  /// schema/DB constraint (BR-027). No materialized `path` in P1: at depth 2
  /// ancestry is just parentId — a UUID `path` is added only if/when depth
  /// grows and subtree filtering is needed (ADR-0015).
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  depth     Int        @default(0)
  /// The vertical this category belongs to — ADR-0015. A plain string
  /// validated against the code registry (src/lib/service-types) AND a DB
  /// CHECK constraint (see the P1 migration), deliberately NOT a Prisma enum
  /// so adding a vertical never needs an ALTER TYPE migration — the same
  /// convention as FeatureFlag.key / BookingContract.templateKey /
  /// AuditLog.action. Governed keys: EXPERIENCE, TRANSPORT, ACCOMMODATION,
  /// DINING, EVENT, RENTAL. Category is browse/SEO only (BR-024) — it never
  /// carries booking/pricing/commission behavior; that lives on ServiceType.
  serviceTypeKey String
  visibilityStatus CategoryVisibilityStatus @default(HIDDEN)
  /// Only meaningful when visibilityStatus is SCHEDULED — the moment this
  /// category should automatically become PUBLIC. Nullable because every
  /// other status ignores it.
  scheduledVisibleAt DateTime? @db.Timestamptz(6)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  /// RETAINED SHADOW — ADR-0015 expand/contract. The P1 expand migration
  /// copied every sub_categories row into THIS table as a depth-1 child; the
  /// sub_categories table is kept as an unread backup until a later, verified
  /// contract migration drops it. The application no longer reads this
  /// relation (get-categories.ts / get-category-detail.ts use `children`).
  /// Do not add new consumers.
  subCategories SubCategory[]
  services      Service[]
  providerLinks ProviderCategory[]

  @@index([parentId])
  @@index([serviceTypeKey])
  @@index([visibilityStatus])
  @@map("categories")
}

/// Provider "areas of activity" — ADR-0015 (BR-025). Many-to-many: a
/// provider selects one or more provider-selectable categories; no free-text
/// categories. `isPrimary` is deliberately NOT modeled in P1 (no consumer
/// yet) — when added in P4, "exactly one primary per provider" will be
/// enforced by a Postgres partial unique index, not application logic.
model ProviderCategory {
  providerId String   @db.Uuid
  categoryId String   @db.Uuid
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@id([providerId, categoryId])
  @@index([categoryId])
  @@map("provider_categories")
}

model SubCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])
  /// Bilingual — { "ar": "...", "en": "..." }.
  name       Json
  slug       String   @unique
  /// Independent of the parent Category's own status — resolves
  /// 07-CATEGORIES.md's open inheritance question: a SubCategory holds its
  /// own visibility, but effective visibility is always the stricter of the
  /// two (see isSubCategoryEffectivelyVisible() in category-visibility-policy.ts),
  /// so a SubCategory can never outrank its parent.
  visibilityStatus CategoryVisibilityStatus @default(HIDDEN)
  scheduledVisibleAt DateTime? @db.Timestamptz(6)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([categoryId])
  @@index([visibilityStatus])
  @@map("sub_categories")
}

model Service {
  id          String        @id @default(uuid(7)) @db.Uuid
  providerId  String        @db.Uuid
  provider    Provider      @relation(fields: [providerId], references: [id])
  serviceType String // discriminator for Experience specialization, mirrors AssetType's pattern
  /// Bilingual, required per DATABASE_DESIGN.md §5.
  name        Json
  description Json?
  status      ServiceStatus @default(DRAFT)
  /// Marketplace taxonomy link — ADR-0015 (BR-026). Single nullable FK to the
  /// most-specific Category node (a leaf or a top-level node). Nullable
  /// indefinitely at the schema level; publish-time "exactly one category"
  /// enforcement is an application rule added in P4, never a NOT NULL DB
  /// constraint. onDelete: Restrict — deleting a Category with assigned
  /// Services must fail loudly, never null out or cascade real Services.
  categoryId  String?       @db.Uuid
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  experience   Experience?
  availability Availability[]
  prices       Price[]
  bookings     Booking[]
  mediaAssets  MediaAsset[]

  @@index([providerId])
  @@index([status])
  @@index([categoryId])
  @@map("services")
}

/// Media Foundation (Gap C) — one reusable table for every user-uploaded
/// image (provider logo/cover/portfolio, service cover/gallery). No binary
/// in Postgres: the bytes live in Supabase Storage; this row holds the
/// object key, the resolved public URL (denormalized so read paths need no
/// Supabase round-trip), and file metadata. Ownership is FK-backed — a real
/// providerId/serviceId foreign key with ON DELETE CASCADE — with exactly
/// one set per row (enforced in application code). A polymorphic
/// (ownerType, ownerId) string pair was deliberately rejected in favour of
/// true referential integrity, per the Gap C mandate.
model MediaAsset {
  id         String         @id @default(uuid(7)) @db.Uuid
  ownerType  MediaOwnerType
  kind       MediaKind
  objectKey  String         @unique
  url        String
  mimeType   String
  sizeBytes  Int
  providerId String?        @db.Uuid
  provider   Provider?      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceId  String?        @db.Uuid
  service    Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @db.Timestamptz(6)

  @@index([providerId, kind])
  @@index([serviceId, kind])
  @@map("media_assets")
}

/// Specializes Service via a shared primary key (Class Table Inheritance).
model Experience {
  serviceId      String   @id @db.Uuid
  service        Service  @relation(fields: [serviceId], references: [id])
  guidingContent Json?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)

  @@map("experiences")
}

// =============================================================================
// BOOKING CONTEXT
// =============================================================================

model Booking {
  id         String        @id @default(uuid(7)) @db.Uuid
  customerId String        @db.Uuid
  customer   Customer      @relation(fields: [customerId], references: [id])
  serviceId  String        @db.Uuid
  service    Service       @relation(fields: [serviceId], references: [id])
  /// Denormalized for query convenience — see implementation note 8 above.
  providerId String        @db.Uuid
  provider   Provider      @relation("BookingProvider", fields: [providerId], references: [id])
  driverId   String?       @db.Uuid
  driver     Driver?       @relation(fields: [driverId], references: [id])
  guideId    String?       @db.Uuid
  guide      Guide?        @relation(fields: [guideId], references: [id])
  vehicleId  String?       @db.Uuid
  /// FIXED: this relation incorrectly referenced Vehicle's non-existent
  /// "id" field since the schema was originally authored — Vehicle's
  /// actual primary key is assetId (shared-PK Class Table Inheritance
  /// with Asset). This would have failed real `npx prisma validate`
  /// immediately; it went undetected because that command has never
  /// once succeeded in this sandbox (no network access, every prior
  /// sprint), so nothing ever actually checked it. Found via direct,
  /// field-by-field verification prompted by a specific, correct bug
  /// report — not found by any of the "clean typecheck"/model-count
  /// checks relied on in earlier sprints, which structurally cannot
  /// catch this class of error.
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [assetId])
  status     BookingStatus @default(CREATED)

  /// Group booking support (approved architecture, Entries 066-067):
  /// how many seats/spots this single Booking reserves. Defaults to 1
  /// — every Booking created before this field existed was, in
  /// practice, one seat; this default is a correct retroactive
  /// assumption, not an arbitrary placeholder. Enforced positive by a
  /// CHECK constraint in the migration.
  seats          Int           @default(1)
  /// Nullable — backward-compatible with every Booking created before
  /// this sprint (none reference a slot) and with any future service
  /// that never uses date/time slots at all. Deliberately NOT unique:
  /// many Bookings may reference the same Availability, bounded by
  /// capacity (enforced by application logic in a future phase, not
  /// this sprint — database layer only).
  availabilityId String?       @db.Uuid
  availability   Availability? @relation(fields: [availabilityId], references: [id])

  /// Price snapshot at confirmation — fixed per DOMAIN_MODEL.md invariant.
  priceSnapshotAmount      Decimal?        @db.Decimal(12, 2)
  priceSnapshotCurrency    String?
  /// Commission snapshot at confirmation.
  commissionSnapshotAmount Decimal?        @db.Decimal(12, 2)
  commissionSnapshotTier   CommissionTier?

  confirmedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)

  journey                   Journey?
  invoice                   Invoice?
  payment                   Payment?
  review                    Review?
  supportTickets            SupportTicket[]
  causingWalletTransactions WalletTransaction[]
  causingNotifications      Notification[]
  /// Booking Lifecycle Engine (Phase E.1) — the append-only history of
  /// every status change this Booking has gone through, including its
  /// initial creation. See BookingStatusEvent below.
  statusEvents              BookingStatusEvent[]
  /// Electronic Contract Foundation (Phase E.2) — every contract
  /// (across all versions/revisions) ever generated for this Booking.
  /// See BookingContract below. A Booking may have zero (nothing
  /// generates one automatically yet — see BookingContract's own
  /// comment) or several (one per revision, per requirement #5/#9).
  contracts                 BookingContract[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([confirmedAt])
  @@index([availabilityId])
  /// Phase 5.2 (Production Hardening) — serviceId is queried/grouped
  /// directly by get-provider-bookings.ts and get-dashboard-data.ts's/
  /// get-provider-metrics.ts's groupBy calls, with no index until now.
  @@index([serviceId])
  /// Phase 5.2 (Production Hardening) — the dominant Provider-side
  /// filter shape (get-provider-bookings.ts, get-provider-overview.ts's
  /// many provider+status-scoped counts).
  @@index([providerId, status])
  @@map("bookings")
}

/// Who performed a booking status transition — Phase E.1. No FK to
/// Customer/Provider/User: a transition's actor may be any one of
/// three different tables depending on actorType (a true polymorphic
/// reference), which Prisma cannot express as a single relation: this
/// is a log field (actorId), not a source of referential integrity.
enum BookingActorType {
  CUSTOMER
  PROVIDER
  SYSTEM
  ADMIN
}

/// Booking Lifecycle Engine (Phase E.1) — append-only log of every
/// status transition a Booking goes through, including its initial
/// creation (fromStatus null). This single table is the shared backing
/// store for three of this phase's requirements at once: the Booking
/// Timeline (a booking's own ordered, timestamped history), the
/// Booking History API (the same data exposed over HTTP), and the
/// Booking Activity Log (who/when/what — never a sensitive payload,
/// only structured status values plus an optional short `reason`).
///
/// The ONLY writers of this table are src/lib/booking/lifecycle's
/// recordBookingCreated() (the initial CREATED row) and
/// transitionBooking() (every subsequent change) — no other code path
/// should ever insert into this table directly, mirroring "every
/// status change must pass through one engine."
model BookingStatusEvent {
  id         String           @id @default(uuid(7)) @db.Uuid
  bookingId  String           @db.Uuid
  booking    Booking          @relation(fields: [bookingId], references: [id])
  /// Null only for the initial creation event — there is no "from" state.
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actorType  BookingActorType
  /// Customer.id / Provider.id / User.id (Admin) depending on actorType.
  /// Null when actorType is SYSTEM.
  actorId    String?          @db.Uuid
  /// Optional short, human-readable reason (e.g. "customer requested
  /// cancellation") — never a sensitive payload, per this phase's
  /// explicit "no sensitive data" requirement for the activity log.
  reason     String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  @@index([bookingId, createdAt])
  @@map("booking_status_events")
}

// =============================================================================
// ELECTRONIC CONTRACT FOUNDATION (Phase E.2)
// =============================================================================
// A DEDICATED, booking-scoped contract concept — deliberately NOT the
// pre-existing `Contract`/`ContractStatus` above (that model is a
// customer/provider platform-agreement concept, unrelated to any
// specific Booking, confirmed unused by any app code as of this phase
// — it is left completely untouched). "BookingContract" names this
// distinctly so the two are never confused in code or migrations.
//
// This phase builds the ENGINE only: dedicated model, its own
// lifecycle, template rendering, PDF generation, versioning/history.
// It does NOT wire automatic generation on booking acceptance (see
// src/lib/contracts/create-contract.ts's own comment) and does NOT
// implement electronic signature, QR verification, or government/
// employer/customer approval — only their interfaces (requirement #10).

/// Requirement #2's example lifecycle, mapped 1:1 (no renaming
/// needed — these names already match the request verbatim, unlike
/// Phase E.1's Booking lifecycle which had to map onto pre-existing
/// names). See src/lib/contracts/lifecycle/transitions.ts for the
/// transition matrix.
enum BookingContractStatus {
  DRAFT
  GENERATED
  ISSUED
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Contract History (requirement #8) event types. Deliberately NOT the
/// same shape as BookingStatusEvent's (fromStatus/toStatus pairs):
/// DOWNLOADED can happen many times without any status change at all,
/// so this is a plain, independent event log, not a transition log.
/// SIGNED exists now only so the future signature feature (requirement
/// #10) has a place to log to without a future migration — nothing
/// writes it yet.
enum BookingContractEventType {
  CREATED
  GENERATED
  ISSUED
  ACTIVATED
  DOWNLOADED
  ARCHIVED
  CANCELLED
  COMPLETED
  EXPIRED
  /// Reserved by Phase E.2 for exactly this use — Phase E.3's signing
  /// workflow deliberately does NOT write this generic value (see
  /// CUSTOMER_SIGNED/PROVIDER_SIGNED below instead, which distinguish
  /// who signed); kept defined, unused, for backward/forward
  /// compatibility rather than removed.
  SIGNED
  /// Phase E.3 (Electronic Signature & Contract Execution) — four new,
  /// purely additive values. Adding enum values is a non-breaking
  /// Postgres operation (no rename/removal of any existing value), and
  /// getContractHistory() (Phase E.2) requires NO changes to pick these
  /// up — it already reads every event generically, ordered by time.
  VIEWED
  CUSTOMER_SIGNED
  PROVIDER_SIGNED
  EXECUTED
}

/// The dedicated Contract domain object (requirement #1). One row per
/// contract VERSION — see `version`/`supersedesContractId` below;
/// requirements #5 and #9 both require that editing a contract never
/// overwrites history, so a "change" is always a new row, never an
/// UPDATE to `content`.
model BookingContract {
  id                   String                @id @default(uuid(7)) @db.Uuid
  bookingId            String                @db.Uuid
  booking              Booking               @relation(fields: [bookingId], references: [id])
  /// Human-readable, sequential, unique (requirement #3) — see
  /// src/lib/contracts/contract-number.ts. Assigned once, at creation;
  /// a Postgres UNIQUE constraint is the actual "no duplicates"
  /// guarantee, not merely application-level discipline.
  contractNumber       String                @unique
  status               BookingContractStatus @default(DRAFT)
  /// Which template produced (or will produce) `content` — see
  /// src/lib/contracts/templates/. A plain String, not a Prisma enum:
  /// adding a new template must not require a migration (requirement
  /// #4's "do not hardcode template text" extends to "do not hardcode
  /// the set of templates into the schema either").
  templateKey          String
  /// The template's own version at generation time — captured so a
  /// later edit to a template's wording never silently reinterprets
  /// what an already-generated contract's `content` is supposed to
  /// mean (distinct from `version` below, which versions THIS
  /// contract, not the template).
  templateVersion      Int
  /// Null until GENERATED. Bilingual JSON (ADR-0005 convention, same
  /// shape as Service.name etc.) — the actual rendered contract body.
  /// Never mutated once set — see the file-level comment above.
  content              Json?
  /// This contract's own version number (requirement #5) — 1 for the
  /// first version, incremented by createContractRevision() for each
  /// later revision. Distinct from templateVersion above.
  version              Int                   @default(1)
  /// Requirement #9 (Archive): set when a newer revision supersedes
  /// this row. An archived row is never written to again — its
  /// `content`/`status` are frozen at whatever they were when
  /// superseded, which is itself usually a terminal status already.
  archivedAt           DateTime?             @db.Timestamptz(6)
  /// Requirement #5's "Generated By" — who/what triggered content
  /// generation. Reuses Phase E.1's BookingActorType rather than
  /// defining a parallel one (CUSTOMER/PROVIDER/SYSTEM/ADMIN already
  /// covers every actor a contract generation could have).
  generatedByActorType BookingActorType?
  generatedByActorId   String?               @db.Uuid
  generatedAt          DateTime?             @db.Timestamptz(6)
  /// Requirement #5's "Created Date".
  createdAt            DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(6)

  /// Requirement #9 versioning chain — mirrors the exact self
  /// -relation pattern the pre-existing `Contract` model above already
  /// uses for its own supersession, rather than inventing a new idiom.
  supersedesContractId String?          @unique @db.Uuid
  supersedesContract   BookingContract? @relation("BookingContractRevision", fields: [supersedesContractId], references: [id])
  supersededByContract BookingContract? @relation("BookingContractRevision")

  events     BookingContractEvent[]
  /// Phase E.3 (Electronic Signature & Contract Execution) — the
  /// signing workflow for this contract, if one has been started. At
  /// most one per BookingContract (unique FK on ContractExecution
  /// below) — a superseded/archived contract's own execution (if any)
  /// stays with that specific row; a revision starts a fresh one.
  execution  ContractExecution?
  signatures ContractSignature[]

  @@index([bookingId])
  @@index([status])
  @@map("booking_contracts")
}

/// Contract History / Activity Log (requirement #8, Phase E.2).
/// Mirrors BookingStatusEvent's role for Bookings (Phase E.1) — writers
/// are src/lib/contracts' own transitionContract() (status-change event
/// types), the standalone recorder functions (createContractFromBooking
/// for CREATED, recordContractDownloaded for DOWNLOADED,
/// createContractRevision for ARCHIVED), and — added Phase E.3 —
/// src/lib/contracts/execution's own view/sign/execution-transition
/// functions (VIEWED, CUSTOMER_SIGNED, PROVIDER_SIGNED, EXECUTED).
model BookingContractEvent {
  id         String                   @id @default(uuid(7)) @db.Uuid
  contractId String                   @db.Uuid
  contract   BookingContract          @relation(fields: [contractId], references: [id])
  eventType  BookingContractEventType
  actorType  BookingActorType
  actorId    String?                  @db.Uuid
  /// Optional short, human-readable note — never a sensitive payload,
  /// mirroring BookingStatusEvent's own `reason` field.
  note       String?
  createdAt  DateTime                 @default(now()) @db.Timestamptz(6)

  @@index([contractId, createdAt])
  @@map("booking_contract_events")
}

// =============================================================================
// ELECTRONIC SIGNATURE & CONTRACT EXECUTION (Phase E.3)
// =============================================================================
// Extends the Contract Engine (Phase E.2) — does NOT modify it.
// BookingContract, BookingContractStatus, and its transition matrix
// (src/lib/contracts/lifecycle/) are completely untouched. This is a
// parallel, additive workflow layered on top: a BookingContract moves
// through its own DRAFT/GENERATED/ISSUED/ACTIVE/... lifecycle exactly
// as Phase E.2 built it; ContractExecution tracks the SIGNING process
// specifically (requirement #1's own, separate state machine), and
// reaching EXECUTED calls the Contract Engine's own, unmodified
// transitionContractAndFireHooks() to move the contract itself
// ISSUED -> ACTIVE — using the existing engine's public API, not
// bypassing or duplicating it.

/// Requirement #1's example lifecycle, mapped 1:1 (no renaming needed).
/// See src/lib/contracts/execution/transitions.ts for the matrix.
enum ContractExecutionStatus {
  PENDING_CUSTOMER
  CUSTOMER_SIGNED
  PENDING_PROVIDER
  PROVIDER_SIGNED
  EXECUTED
  CANCELLED
  EXPIRED
}

/// Broad signing mechanism category — requirement #3's "signature
/// method". INTERNAL is this phase's only real, working path (a
/// simple in-app click-to-sign — "This is NOT the final electronic
/// signature implementation", per Phase E.2's own framing, carried
/// forward here). EXTERNAL_PROVIDER is reserved for when a real vendor
/// (DocuSign, Adobe Sign, Government PKI, Oman Trust Services) is
/// wired in — the SPECIFIC vendor is recorded in
/// ContractSignature.providerKey (a plain String, like
/// BookingContract.templateKey), not this enum, so adding a new vendor
/// never requires a migration.
enum ContractSignatureMethod {
  INTERNAL
  EXTERNAL_PROVIDER
}

/// One row per BookingContract that has entered the signing workflow —
/// requirement #1's state machine's current position. Kept as its own
/// table, not new columns on BookingContract, so the Contract Engine's
/// own table has zero schema changes this phase (nothing here can be
/// mistaken for "modifying Contract Engine architecture").
model ContractExecution {
  id                String                  @id @default(uuid(7)) @db.Uuid
  contractId        String                  @unique @db.Uuid
  contract          BookingContract         @relation(fields: [contractId], references: [id])
  status            ContractExecutionStatus @default(PENDING_CUSTOMER)
  /// Requirement #6 — an opaque, unique lookup token for the public
  /// verification endpoint. Generated once, at execution start; never
  /// regenerated (a rotating token would invalidate a QR code already
  /// printed on an issued contract).
  verificationToken String                  @unique
  /// Requirement #1's "Expired" branch — a deadline this execution
  /// lapses at if not completed. Nullable: not every execution
  /// necessarily has one (a future caller may choose not to set one).
  expiresAt         DateTime?               @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(6)

  signatures ContractSignature[]

  @@index([status])
  @@map("contract_executions")
}

/// Requirement #3 — one immutable row per actual signing event. NEVER
/// updated after creation (requirement #3's "Never overwrite
/// signatures") — a re-sign attempt is rejected by the state machine
/// (see execution/errors.ts), not represented by mutating an existing
/// row. `@@unique([executionId, signerType])` is the database-level
/// backstop against duplicate signatures (requirement #9's own test
/// coverage item), not merely an application-level check.
model ContractSignature {
  id                String                  @id @default(uuid(7)) @db.Uuid
  /// Denormalized for query convenience — same rationale as
  /// Booking.providerId above ("likely necessary for query
  /// convenience"): looking up every signature for a contract without
  /// an extra join through ContractExecution.
  contractId        String                  @db.Uuid
  contract          BookingContract         @relation(fields: [contractId], references: [id])
  executionId       String                  @db.Uuid
  execution         ContractExecution       @relation(fields: [executionId], references: [id])
  signerType        BookingActorType
  signerId          String?                 @db.Uuid
  signedAt          DateTime                @default(now()) @db.Timestamptz(6)
  /// Requirement #3 — "IP (configurable/privacy-aware)": whether this
  /// is ever populated is controlled by
  /// src/lib/contracts/execution/ip-config.ts, not hardcoded — a
  /// deployment may disable IP capture entirely, in which case this
  /// stays null regardless of what the caller had available.
  ipAddress         String?
  /// Requirement #3 — explicitly optional.
  userAgent         String?
  method            ContractSignatureMethod
  /// Which SignatureProvider produced this signature (e.g.
  /// "INTERNAL", future "DOCUSIGN") — a plain String, like
  /// BookingContract.templateKey, so a new provider never requires a
  /// migration.
  providerKey       String
  /// An external reference ID from that provider (e.g. a future
  /// DocuSign envelope ID) — unused by the INTERNAL provider today.
  providerReference String?

  @@unique([executionId, signerType])
  @@index([contractId])
  @@map("contract_signatures")
}

// =============================================================================
// TRACKING CONTEXT
// =============================================================================

model Journey {
  id          String        @id @default(uuid(7)) @db.Uuid
  bookingId   String        @unique @db.Uuid
  booking     Booking       @relation(fields: [bookingId], references: [id])
  status      JourneyStatus @default(NOT_STARTED)
  startedAt   DateTime?     @db.Timestamptz(6)
  completedAt DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  routes Route[]

  @@map("journeys")
}

/// Immutable once finalized — no updatedAt, per DOMAIN_MODEL.md invariant.
model Route {
  id                 String      @id @default(uuid(7)) @db.Uuid
  journeyId          String      @db.Uuid
  journey            Journey     @relation(fields: [journeyId], references: [id])
  status             RouteStatus @default(PLANNED)
  /// Individual location point structure is an implementation detail,
  /// out of scope for PRISMA_SCHEMA.md — stored as a JSON array of points.
  locationRecordings Json?
  createdAt          DateTime    @default(now()) @db.Timestamptz(6)

  @@index([journeyId])
  @@map("routes")
}

model Availability {
  id          String                @id @default(uuid(7)) @db.Uuid
  serviceId   String                @db.Uuid
  service     Service               @relation(fields: [serviceId], references: [id])
  startTime   DateTime              @db.Timestamptz(6)
  endTime     DateTime              @db.Timestamptz(6)
  /// Total bookable spots in this slot. Non-nullable, defaults to 1 —
  /// existing rows predate this field and were implicitly
  /// single-occupancy (no Booking↔Availability link existed at all
  /// before this sprint), so defaulting to 1 preserves that original
  /// meaning rather than introducing an ambiguous "unknown" state.
  /// Enforced positive by a CHECK constraint in the migration — see
  /// migration.sql for why this isn't expressed via Prisma DSL.
  capacity    Int                   @default(1)
  /// Running count of seats currently reserved against this slot.
  /// Must be kept in sync with Booking.seats transactionally — that
  /// enforcement is application logic for a future phase, NOT built
  /// in this sprint (database layer only, per explicit instruction).
  /// Bounded by capacity via a CHECK constraint in the migration.
  bookedCount Int                   @default(0)
  state       AvailabilitySlotState @default(OPEN)
  createdAt   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(6)

  bookings Booking[]

  @@index([serviceId])
  @@index([startTime, endTime])
  @@map("availabilities")
}

// =============================================================================
// PRICING CONTEXT
// =============================================================================

model Price {
  id        String      @id @default(uuid(7)) @db.Uuid
  serviceId String      @db.Uuid
  service   Service     @relation(fields: [serviceId], references: [id])
  amount    Decimal     @db.Decimal(12, 2)
  currency  String
  status    PriceStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  @@index([serviceId])
  @@index([status])
  @@map("prices")
}

model Commission {
  id         String           @id @default(uuid(7)) @db.Uuid
  providerId String           @db.Uuid
  provider   Provider         @relation(fields: [providerId], references: [id])
  tier       CommissionTier
  status     CommissionStatus @default(ACTIVE)
  createdAt  DateTime         @default(now()) @db.Timestamptz(6)

  walletTransactions WalletTransaction[]

  @@index([providerId])
  @@index([status])
  @@map("commissions")
}

// =============================================================================
// WALLET CONTEXT
// =============================================================================

model Wallet {
  id         String    @id @default(uuid(7)) @db.Uuid
  providerId String?   @unique @db.Uuid
  provider   Provider? @relation(fields: [providerId], references: [id])
  customerId String?   @unique @db.Uuid
  customer   Customer? @relation(fields: [customerId], references: [id])
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(6)

  transactions WalletTransaction[]

  @@map("wallets")
}

/// Immutable, append-only ledger entry — no updatedAt, ever.
/// Polymorphic "causing event" reference resolved as nullable typed FKs —
/// see implementation note 3 above.
model WalletTransaction {
  id          String                     @id @default(uuid(7)) @db.Uuid
  walletId    String                     @db.Uuid
  wallet      Wallet                     @relation(fields: [walletId], references: [id])
  direction   WalletTransactionDirection
  /// PROVISIONAL enum — see note above CommissionCause definition.
  cause       WalletTransactionCause
  amount      Decimal                    @db.Decimal(12, 2)
  currency    String
  description String?

  causingBookingId    String?     @db.Uuid
  causingBooking      Booking?    @relation(fields: [causingBookingId], references: [id])
  causingPaymentId    String?     @db.Uuid
  causingPayment      Payment?    @relation(fields: [causingPaymentId], references: [id])
  causingCommissionId String?     @db.Uuid
  causingCommission   Commission? @relation(fields: [causingCommissionId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// =============================================================================
// PAYMENTS CONTEXT
// =============================================================================

model Payment {
  id        String  @id @default(uuid(7)) @db.Uuid
  bookingId String  @unique @db.Uuid
  booking   Booking @relation(fields: [bookingId], references: [id])
  amount    Decimal @db.Decimal(12, 2)
  currency  String
  /// Phase 2.24 (Provider Reference Persistence). An opaque external
  /// identifier from whichever PaymentGatewayProvider actually produced
  /// this Payment (e.g. a Stripe PaymentIntent id) — set by initiate(),
  /// read back by capture(). Nullable: the No-Op gateway's initiate()
  /// never returns one (see that provider's own comment), so any
  /// Payment created under PAYMENT_PROVIDER=NONE correctly has none.
  /// Mirrors ContractSignature.providerReference (Phase E.3) exactly —
  /// same name, same plain-String type, same "external provider's own
  /// reference, opaque to this codebase" purpose.
  providerReference String?
  status            PaymentStatus @default(INITIATED)
  refundAmount      Decimal?      @db.Decimal(12, 2)
  capturedAt        DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  invoice            Invoice?
  walletTransactions WalletTransaction[]
  supportTickets     SupportTicket[]

  @@index([status])
  @@map("payments")
}

// =============================================================================
// INVOICING CONTEXT
// =============================================================================

/// Immutable once issued — createdAt only, per DOMAIN_MODEL.md invariant.
model Invoice {
  id                      String        @id @default(uuid(7)) @db.Uuid
  bookingId               String        @unique @db.Uuid
  booking                 Booking       @relation(fields: [bookingId], references: [id])
  paymentId               String?       @unique @db.Uuid
  payment                 Payment?      @relation(fields: [paymentId], references: [id])
  invoiceNumber           String        @unique
  /// Bilingual document content, required per DATABASE_DESIGN.md §5.
  content                 Json
  status                  InvoiceStatus @default(GENERATED)
  supersedingCreditNoteId String?       @unique @db.Uuid
  supersedingCreditNote   Invoice?      @relation("InvoiceCreditNote", fields: [supersedingCreditNoteId], references: [id])
  supersededByCreditNote  Invoice?      @relation("InvoiceCreditNote")
  issuedAt                DateTime      @db.Timestamptz(6)
  createdAt               DateTime      @default(now()) @db.Timestamptz(6)

  @@map("invoices")
}

// =============================================================================
// CONTRACTS CONTEXT
// =============================================================================

model Contract {
  id                    String         @id @default(uuid(7)) @db.Uuid
  providerId            String?        @db.Uuid
  provider              Provider?      @relation(fields: [providerId], references: [id])
  customerId            String?        @db.Uuid
  customer              Customer?      @relation(fields: [customerId], references: [id])
  /// Bilingual, required per DATABASE_DESIGN.md §5.
  terms                 Json
  status                ContractStatus @default(DRAFTED)
  signedAt              DateTime?      @db.Timestamptz(6)
  supersedingContractId String?        @unique @db.Uuid
  supersedingContract   Contract?      @relation("ContractSupersession", fields: [supersedingContractId], references: [id])
  supersededByContract  Contract?      @relation("ContractSupersession")
  createdAt             DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @db.Timestamptz(6)

  @@index([providerId])
  @@index([customerId])
  @@index([status])
  @@map("contracts")
}

// =============================================================================
// NOTIFICATIONS CONTEXT
// =============================================================================

model Notification {
  id      String              @id @default(uuid(7)) @db.Uuid
  userId  String              @db.Uuid
  user    User                @relation(fields: [userId], references: [id])
  /// Bilingual, required per ADR-0005 and DOMAIN_MODEL.md invariant.
  content Json
  channel NotificationChannel
  status  NotificationStatus  @default(COMPOSED)
  /// Read state (Phase D.1) — null means unread; set once, to the
  /// moment the recipient reads it, never cleared back to null. This is
  /// a distinct concept from `status`: `status` tracks WHATSAPP/EMAIL/SMS
  /// delivery lifecycle (COMPOSED -> SENT -> DELIVERED -> FAILED), while
  /// `readAt` tracks whether the in-app Notification Center recipient
  /// has actually seen it — a DELIVERED notification can still be
  /// unread, and the two are updated independently.
  readAt  DateTime?           @db.Timestamptz(6)

  causingBookingId String?  @db.Uuid
  causingBooking   Booking? @relation(fields: [causingBookingId], references: [id])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  /// Phase D.1 — serves getUnreadCount()'s `WHERE userId = ? AND readAt
  /// IS NULL` and getNotifications()'s paginated, newest-first list for
  /// one user, without a table scan.
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// =============================================================================
// REVIEWS CONTEXT
// =============================================================================

model Review {
  id              String                @id @default(uuid(7)) @db.Uuid
  bookingId       String                @unique @db.Uuid
  booking         Booking               @relation(fields: [bookingId], references: [id])
  customerId      String                @db.Uuid
  customer        Customer              @relation(fields: [customerId], references: [id])
  /// Denormalized for Provider aggregate-rating queries — see
  /// implementation note 8 above.
  providerId      String                @db.Uuid
  provider        Provider              @relation("ReviewProvider", fields: [providerId], references: [id])
  content         String
  moderationState ReviewModerationState @default(PUBLISHED)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)

  rating Rating?

  @@index([customerId])
  @@index([providerId])
  @@map("reviews")
}

/// Immutable — no updatedAt, per DOMAIN_MODEL.md invariant.
/// PROVISIONAL numeric range (assumed 1–5) — see implementation note 5 above.
model Rating {
  id       String @id @default(uuid(7)) @db.Uuid
  reviewId String @unique @db.Uuid
  review   Review @relation(fields: [reviewId], references: [id])
  value    Int

  @@map("ratings")
}

// =============================================================================
// OPERATIONS CONTEXT
