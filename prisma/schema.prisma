enum UserStatus {
  CREATED
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProviderStatus {
  APPLIED
  UNDER_REVIEW
  APPROVED
  SUSPENDED
  DEACTIVATED
}

/// Whether a provider is an individual (driver/guide/photographer/freelancer/
/// independent operator) or a company (Gap D). ONE Provider bounded context —
/// this is a presentation/wording discriminator only; it never forks auth,
/// dashboards, services, bookings, or the Driver/Guide/Asset specializations,
/// which remain related to Provider regardless of type. Backward-compatible
/// default COMPANY: every pre-existing Provider was created with a REQUIRED
/// businessName under business semantics (apply-as-provider.ts / admin
/// create-provider.ts), so COMPANY safely classifies all existing rows.
enum ProviderType {
  INDIVIDUAL
  COMPANY
}

// Media Foundation (Gap C) — discriminators for the reusable MediaAsset
// table (see the model below).
enum MediaOwnerType {
  PROVIDER
  SERVICE
}

enum MediaKind {
  LOGO
  COVER
  PORTFOLIO
  GALLERY
}

enum DriverStatus {
  REGISTERED
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum GuideStatus {
  REGISTERED
  VERIFIED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AssetStatus {
  REGISTERED
  VERIFIED
  ACTIVE
  UNDER_MAINTENANCE
  DEACTIVATED
}

/// Deliberately open to future values beyond VEHICLE — per Asset's
/// documented generality in DOMAIN_MODEL.md.
enum AssetType {
  VEHICLE
}

enum ServiceStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

/// EXPIRED added Phase 5.1 (Production Readiness) — a system-driven
/// terminal outcome distinct from CANCELLED (customer-initiated) and
/// REJECTED (provider's explicit decision): a PENDING_PROVIDER request
/// whose Availability slot's startTime passed with no provider
/// response. Kept as its own value (not folded into CANCELLED/REJECTED)
/// so completion/cancellation-rate metrics and notifications stay
/// accurate about which party actually caused the outcome.
enum BookingStatus {
  CREATED
  PENDING_PROVIDER
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  DISPUTED
  EXPIRED
}

enum JourneyStatus {
  NOT_STARTED
  STARTED
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
}

enum RouteStatus {
  PLANNED
  RECORDING
  FINALIZED
}

/// Revised per the approved Availability capacity architecture
/// (DEVELOPMENT_LOG.md Entries 066-067): BOOKED removed — "fully
/// booked" is now a computed condition (bookedCount >= capacity), not
/// a stored state, since a slot can now be partially filled. CANCELLED
/// added — a provider cancelling a specific slot is now distinguishable
/// from a slot simply reaching capacity, which the old binary state
/// could never represent.
enum AvailabilitySlotState {
  OPEN
  BLOCKED
  CANCELLED
}

enum PriceStatus {
  ACTIVE
  SUPERSEDED
}

enum CommissionStatus {
  ACTIVE
  SUPERSEDED
}

/// The three defined commission rates — GLOSSARY.md term 19.
enum CommissionTier {
