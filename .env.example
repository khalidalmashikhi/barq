# Environment variables for local development.
# Never commit actual secrets — this file documents required keys only.
# Full secrets management strategy: SECURITY.md §8, DEPLOYMENT_AND_INFRASTRUCTURE.md §11.

# Database (ADR-0006 — PostgreSQL via Prisma)
#
# Two-URL connection model (prisma/schema.prisma: url + directUrl), required
# for Supabase + Prisma + Vercel serverless:
#
#   DATABASE_URL — RUNTIME connection used by Prisma Client (the app). Point
#     it at Supabase's TRANSACTION pooler (port 6543) with the query params
#     `?pgbouncer=true&connection_limit=1` (append `&sslmode=require` if your
#     project requires TLS in the string). Transaction-mode multiplexing +
#     connection_limit=1 per serverless instance is what prevents Supavisor
#     session-pool exhaustion (FATAL EMAXCONNSESSION / "max clients reached in
#     session mode") under Vercel's fan-out.
#     e.g. postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#
#   DIRECT_URL — MIGRATION/CLI connection used by `prisma migrate deploy`
#     (vercel-build) and other Prisma CLI commands. Point it at Supabase's
#     SESSION pooler (port 5432); the migration engine cannot run through a
#     transaction-mode pooler. Not used by the running app.
#     e.g. postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
#
# Locally you may set both to the same session-pooler (5432) URL — the
# transaction pooler only matters under real serverless load.
DATABASE_URL=
DIRECT_URL=

# Public site URL (Phase B Group 5 — SEO/hreflang: resolves metadataBase
# for canonical/hreflang URLs). Defaults to http://localhost:3000 in
# code if unset; set to the real production origin before deploying.
# REQUIRED IN PRODUCTION (Phase D.3 — scripts/validate-env.ts fails the
# build/start if NODE_ENV=production and this is unset): every
# canonical/hreflang/Open Graph URL silently breaks otherwise. Optional
# only for local development.
NEXT_PUBLIC_APP_URL=

# Authentication (AUTHENTICATION.md §4 — Better Auth)
# REQUIRED, min 32 characters IN PRODUCTION (Phase D.3 —
# scripts/validate-env.ts fails the build/start otherwise). Generate a
# real, random value — never reuse a value from a local .env or CI
# fixture. e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Server-side base URL Better Auth issues/validates callbacks against.
BETTER_AUTH_URL=
# Same origin, exposed to the browser for the Better Auth client
# (src/lib/auth/client.ts). Must be a valid URL — both this and
# BETTER_AUTH_URL above are required (see scripts/validate-env.ts).
NEXT_PUBLIC_BETTER_AUTH_URL=

# Object Storage — Supabase Storage (Media Foundation, Gap C). ALL OPTIONAL:
# the media foundation degrades gracefully when unset (upload actions decline
# politely; the rest of the app is unaffected). To ACTIVATE media uploads on a
# deployment, provision a public Supabase Storage bucket and set the first two;
# the bucket name defaults to "media" if the third is omitted.
#   SUPABASE_URL                — your Supabase project URL (https://<ref>.supabase.co)
#   SUPABASE_SERVICE_ROLE_KEY   — service-role key (server-only; never exposed to the browser)
#   SUPABASE_STORAGE_BUCKET     — public bucket name (default: "media")
#   SUPABASE_DOCS_BUCKET        — SEPARATE PRIVATE bucket for provider verification
#                                 documents (Gate 2). No default, no fallback to the
#                                 public bucket — unset means documents are inert
#                                 (fail-closed). Must be a PRIVATE bucket; reads are
#                                 via short-lived signed URLs only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SUPABASE_DOCS_BUCKET=

# Google Social Login (Gate 3). BOTH OPTIONAL and all-or-nothing: Google sign-in
# is available only when BOTH are set (fail-closed, src/lib/auth/social-config.ts)
# — a deployment with neither simply shows no Google button and boots normally
# (local/dev never require them). scripts/validate-env.ts REJECTS a partial
# config (exactly one set) so an intentionally-enabled-but-incomplete setup fails
# clearly. Phone + OTP is always supported alongside Google. Apple is deferred.
#   GOOGLE_CLIENT_ID     — OAuth 2.0 Web client ID (Google Cloud Console). NOT a
#                          secret (it appears in redirect flows).
#   GOOGLE_CLIENT_SECRET — OAuth client secret (server-only; never exposed to the
#                          browser). The Better Auth callback is
#                          <BETTER_AUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deployment target — "staging" | "production" (optional; unset means
# local development). Distinct from NODE_ENV, which Vercel always sets to
# "production" for ANY deployed instance (staging included). APP_ENV lets
# scripts/validate-env.ts tell a staging deploy apart from a real
# production deploy — specifically, it gates the staging-only
# OTP_PROVIDER=disabled mode below. Leave unset for local dev; set
# APP_ENV=staging on the staging deployment; set APP_ENV=production on the
# real production deployment (which then requires a real OTP provider).
APP_ENV=

# OTP Delivery (Phase D.4 — Production OTP Integration)
#
# OTP_PROVIDER selects the delivery vendor:
#   "console"  (default) — prints codes to the server terminal, DEV-ONLY.
#              Refuses to run when NODE_ENV=production, and
#              scripts/validate-env.ts fails the build/start if it resolves
#              to "console" in production.
#   "twilio"   — real SMS/WhatsApp delivery (requires the TWILIO_* vars).
#   "disabled" — STAGING-ONLY. No OTP is generated, sent, logged, or
#              exposed; every send fails closed, so nobody can log in. It
#              exists only so a staging deployment can boot under
#              NODE_ENV=production before a real OTP vendor is provisioned.
#              scripts/validate-env.ts permits it ONLY when APP_ENV=staging,
#              and rejects it for APP_ENV=production (and when APP_ENV is
#              unset). It never weakens or bypasses authentication.
# Adding another real vendor only requires a new class in
# src/lib/otp/providers/ plus a case in get-otp-provider.ts.
OTP_PROVIDER=console

# REQUIRED when OTP_PROVIDER=twilio. Twilio Console > Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format (e.g. +14155238886) — your Twilio SMS number, or your
# approved WhatsApp Business sender if OTP_CHANNEL=whatsapp.
TWILIO_FROM_NUMBER=
# Optional. "sms" (default) or "whatsapp".
OTP_CHANNEL=sms

# Payment Provider (Phase 2.22A — Provider Selection Architecture
# Refinement). Mirrors OTP_PROVIDER's own shape exactly: PAYMENT_PROVIDER
# selects the active vendor for get-payment-gateway-provider.ts/
# get-payment-webhook-adapter.ts/get-payment-webhook-verifier.ts (always
# a matched trio). "NONE" (the default) keeps every payment call
# resolving to the safe No-Op/Generic defaults — nothing in this
# codebase can move money without this being explicitly set. Set to
# "STRIPE" to activate the Stripe reference implementation (Phase 2.22)
# for the webhook route; accept-booking.ts/capture-payment.ts
# deliberately still hardcode "NONE" regardless of this setting (a
# separate, not-yet-done wiring phase would be needed to change that).
PAYMENT_PROVIDER=NONE

# REQUIRED when PAYMENT_PROVIDER=STRIPE. Stripe Dashboard > Developers >
# API keys / Webhooks. src/lib/payments/gateway/providers/
# stripe-payment-gateway-provider.ts,
# src/lib/payments/webhooks/security/providers/
# stripe-payment-webhook-verifier.ts. Leaving these unset while
# PAYMENT_PROVIDER=NONE (the default) keeps the webhook endpoint
# reachable but functionally inert (it fails closed with a 500), never
# able to move money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — OTP lifecycle tuning. Defaults match Better Auth's own
# phoneNumber plugin defaults (expiresIn: 300s, allowedAttempts: 3);
# OTP_RESEND_COOLDOWN_SECONDS and OTP_MAX_SENDS_PER_DAY have no Better
# Auth built-in equivalent and are this project's own additions
# (Phase D.4, extended Phase 5.1) — the latter caps total OTP sends per
# phone number within a rolling 24h window, the real SMS-cost abuse
# vector once a real delivery provider is live.
OTP_EXPIRES_IN_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_SENDS_PER_DAY=10

# Email OTP (AUTH-CUSTOMER-EMAIL-OTP) — an ADDITIONAL customer sign-in method
# alongside phone OTP and Google. INERT by default: with EMAIL_OTP_PROVIDER
# unset or "disabled", email sign-in fails closed and the "Continue with email"
# option is not shown. No email vendor is wired yet — "console" is dev-only
# (prints the code to the server terminal; rejected in production, like
# OTP_PROVIDER=console). A real vendor is a future dependency-approving gate.
#   disabled = off / inert (default; safe in production)
#   console  = local development only (prints code to terminal)
EMAIL_OTP_PROVIDER=disabled

# Optional — email OTP lifecycle tuning. Defaults match Better Auth's emailOTP
# plugin (expiresIn 300s, allowedAttempts 3, otpLength 6); the cooldown and
# daily cap mirror the phone OTP choices and are enforced by BARQ's durable
# limiter. Runtime-validated (fail-fast on a malformed value), not by env-schema.
EMAIL_OTP_EXPIRES_IN_SECONDS=300
EMAIL_OTP_MAX_ATTEMPTS=3
EMAIL_OTP_LENGTH=6
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=30
EMAIL_OTP_MAX_SENDS_PER_DAY=10
# Optional — durable per-IP / per-email email-OTP abuse caps (defaults shown).
AUTH_EMAIL_OTP_SEND_IP_MAX=15
AUTH_EMAIL_OTP_SEND_IP_WINDOW_SECONDS=3600
AUTH_EMAIL_OTP_SEND_EMAIL_MAX=6
AUTH_EMAIL_OTP_SEND_EMAIL_WINDOW_SECONDS=3600
AUTH_EMAIL_OTP_VERIFY_IP_MAX=30
AUTH_EMAIL_OTP_VERIFY_IP_WINDOW_SECONDS=3600

# Contract Signature Execution (Phase E.3)
#
# Optional. Controls whether a signer's IP address is persisted on a
# ContractSignature record. Defaults to enabled (true) if unset — an
# audit-trail IP is not itself sensitive contract content. Set to
# "false" or "0" to disable IP capture entirely (e.g. for a
# jurisdiction/policy that treats it as unnecessary personal data
# collection). See src/lib/contracts/execution/ip-config.ts.
CONTRACT_SIGNATURE_LOG_IP=

# WhatsApp Business API (TECH_STACK.md §10)
WHATSAPP_API_TOKEN=

# LLM Gateway (TECH_STACK.md §11 — provider abstraction)
LLM_GATEWAY_API_KEY=

# Maps (TECH_STACK.md §9 — Google Maps Platform)
GOOGLE_MAPS_API_KEY=

# Rate Limiting (Production Hardening)
#
# Optional tuning for the in-memory, per-customer rate limits on
# booking and review creation (src/lib/rate-limit/). Defaults are
# generous (20 requests/hour each) — an abuse deterrent, not a
# UX-facing quota. See src/lib/rate-limit/rate-limiter.ts's own comment
# for why this is in-memory (per-instance, not a global/durable limit)
# rather than Redis/database-backed.
RATE_LIMIT_BOOKING_CREATE_MAX=20
RATE_LIMIT_BOOKING_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_REVIEW_CREATE_MAX=20
RATE_LIMIT_REVIEW_CREATE_WINDOW_SECONDS=3600

# Cron authentication (Phase 5.1 — Production Readiness)
#
# REQUIRED IN PRODUCTION (scripts/validate-env.ts fails the build/start
# otherwise). Verifies the `Authorization: Bearer <CRON_SECRET>` header
# Vercel Cron automatically sends when it invokes
# /api/cron/expire-stale-bookings (see vercel.json) — without this, that
# route would accept requests from anyone. Generate a real, random
# value, e.g. `openssl rand -base64 32`.
CRON_SECRET=
