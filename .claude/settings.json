{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git ls-remote *)",
      "Bash(git merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit *)",
      "Bash(npx eslint *)",
      "Bash(npx vitest run *)",
      "Bash(npx prisma validate)",
      "Bash(npx prisma generate)",
      "Bash(npx prisma migrate status)",
      "Bash(node scripts/engineering/*)",
      "Bash(npx vercel whoami)",
      "Bash(npx vercel inspect *)",
      "Bash(npx vercel ls *)",
      "Bash(npx vercel logs *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh workflow run *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(npx prisma migrate resolve *)",
      "Bash(npx prisma db *)",
      "Bash(npm run prisma:migrate *)",
      "Bash(npm run bootstrap-* *)",
      "Bash(npm run backfill-* *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx vercel deploy *)",
      "Bash(npx vercel redeploy *)"
    ],
    "deny": [
      "Bash(* --dangerously-skip-permissions*)",
      "Bash(* --no-verify*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * master)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git commit --amend*)",
      "Bash(git rebase *)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel * --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(npx vercel promote *)",
      "Bash(npx vercel rollback *)",
      "Bash(npx vercel alias *)",
      "Bash(npx vercel env *)",
      "Bash(vercel env *)",
      "Bash(printenv*)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.staging)",
      "Read(./.vercel/**)",
      "Read(./scripts/load-test/.session-pool.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"", "timeout": 90 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"", "timeout": 60 }]
      }
    ]
  }
}
